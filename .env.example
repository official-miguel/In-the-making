# Shared library (Supabase). Copy to .env.local and fill in from
# Supabase dashboard > Project Settings > API. The anon/publishable key is safe in the browser;
# NEVER put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
